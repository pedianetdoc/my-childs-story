# Server-side only. Copy to .env and fill in locally; never commit real values.
# These must never be imported or exposed in client code.

# OpenAI-compatible chat API credential (placeholder)
LLM_API_KEY=your-api-key-here
# Model identifier for the provider (placeholder)
LLM_MODEL=your-model-name-here
# Optional: base URL of the OpenAI-compatible API (placeholder)
LLM_BASE_URL=https://api.example.com/v1
# Optional: LLM request timeout in milliseconds (default 60000)
LLM_TIMEOUT_MS=60000
# Optional: organize requests allowed per IP per 15 minutes (default 10)
RATE_LIMIT_MAX=10

# Port the server listens on (Replit sets this automatically)
PORT=3000

# Optional: number of reverse-proxy hops to trust for client IPs (rate limiting).
# Defaults to 1 in production (Replit), off in development.
TRUST_PROXY=1
